# =============================================================================
# Dros Hub v2 — Variaveis de ambiente
# =============================================================================
# Este arquivo eh template. Copiar pra .env (na raiz do repo, NAO dentro de
# agency-hub/) e preencher com valores reais.
#
# Producao: /root/hub2/.env
# Local dev: dros-hub-v2/.env
# =============================================================================

# --- Auth ---------------------------------------------------------------------
# Segredo pra assinar JWTs. DEVE ser DIFERENTE do v1 pra sessoes ficarem
# isoladas entre /hub e /hub2. Gerar 32 chars aleatorios:
#   openssl rand -hex 32
JWT_SECRET=trocar-por-segredo-aleatorio-32-chars-hex

# --- Server-to-server (usado pelo Core pra falar com o Hub) -------------------
# Mesma chave usada no v1 se quiser que o Core continue funcionando com v2 tb.
# No MVP v2, Core segue apontando pro v1 — deixar em branco ou copiar do v1.
CORE_EMBED_SECRET=

# --- Meta / Instagram Graph API -----------------------------------------------
# Reusar mesma token do v1 (leitura simultanea nao conflita).
META_ACCESS_TOKEN=

# --- Google Ads API v22 -------------------------------------------------------
# Reusar do v1. Se quiser dashboard funcionando standalone, copiar todas.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# OAuth callback URL. Em producao aponta pro dominio do v2.
# Local dev: http://localhost:3007/api/performance/google-ads/callback
HUB_GADS_REDIRECT_URI=https://drosagencia.com.br/hub2/api/performance/google-ads/callback

# --- Kiwify OAuth (integracao ecommerce) --------------------------------------
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_ACCOUNT_ID=

# --- (Futuro) NPS/Pesquisas por email -----------------------------------------
# Se configurar SendGrid/SES/SMTP no futuro, adicionar aqui. Sem isso, F3
# gera links tokenizados pra o gestor copiar/enviar manualmente.
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
